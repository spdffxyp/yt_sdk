	ethernet@fe1b0000 {
		compatible = "rockchip,rk3588-gmac\0snps,dwmac-4.20a";
		reg = <0x00 0xfe1b0000 0x00 0x10000>;
		interrupts = <0x00 0xe3 0x04 0x00 0x00 0xe2 0x04 0x00>;
		interrupt-names = "macirq\0eth_wake_irq";
		clocks = <0x24 0x136 0x24 0x137 0x24 0x158 0x24 0x15d 0x24 0x134>;
		clock-names = "stmmaceth\0clk_mac_ref\0pclk_mac\0aclk_mac\0ptp_ref";
		power-domains = <0x25 0x21>;
		resets = <0x24 0x123>;
		reset-names = "stmmaceth";
		rockchip,grf = <0x76>;
		rockchip,php-grf = <0x31>;
		snps,axi-config = <0x12b>;
		snps,mixed-burst;
		snps,mtl-rx-config = <0x12c>;
		snps,mtl-tx-config = <0x12d>;
		snps,no-vlhash;
		status = "okay";
		clock_in_out = "output";
		phy-mode = "rgmii-rxid";
		tx_delay = <0x44>;
		rx_delay = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x12e 0x12f 0x130 0x131 0x132>;
		snps,reset-active-low;
		snps,reset-delays-us = <0x00 0x4e20 0x186a0>;
		snps,reset-gpio = <0x128 0x18 0x01>;
		phandle = <0x137>;

		mdio {
			compatible = "snps,dwmac-mdio";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			switch@1d {
				compatible = "motorcomm,yt9215";
				reg = <0x1d>;
				dsa,member = <0x01 0x00>;
				motorcomm,bdy-g98-led-profile;

				ethernet-ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					ethernet-port@1 {
						reg = <0x01>;
						label = "lan5";
						phy-handle = <0x133>;
						phy-mode = "internal";
						local-mac-address = [2e 1c f9 a9 5b 05]; 
					};

					ethernet-port@2 {
						reg = <0x02>;
						label = "lan6";
						phy-handle = <0x134>;
						phy-mode = "internal";
						local-mac-address = [2e 1c f9 a9 5b 06]; 
					};

					ethernet-port@3 {
						reg = <0x03>;
						label = "lan7";
						phy-handle = <0x135>;
						phy-mode = "internal";
						local-mac-address = [2e 1c f9 a9 5b 07]; 
					};

					ethernet-port@4 {
						reg = <0x04>;
						label = "lan8";
						phy-handle = <0x136>;
						phy-mode = "internal";
						local-mac-address = [2e 1c f9 a9 5b 08]; 
					};

					ethernet-port@9 {
						reg = <0x09>;
						ethernet = <0x137>;
						phy-mode = "rgmii-txid";

						fixed-link {
							speed = <0x3e8>;
							full-duplex;
							pause;
						};
					};
				};

				mdio {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					ethernet-phy@1 {
						reg = <0x01>;
						phandle = <0x133>;
					};

					ethernet-phy@2 {
						reg = <0x02>;
						phandle = <0x134>;
					};

					ethernet-phy@3 {
						reg = <0x03>;
						phandle = <0x135>;
					};

					ethernet-phy@4 {
						reg = <0x04>;
						phandle = <0x136>;
					};
				};
			};
		};

