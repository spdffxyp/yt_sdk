		pinctrl-0 = <0x90 0x91 0x92 0x93 0x94>;
		snps,reset-active-low;
		snps,reset-delays-us = <0x00 0x4e20 0x186a0>;
		snps,reset-gpio = <0x83 0x0b 0x01>;
		phandle = <0x99>;

		mdio {
			compatible = "snps,dwmac-mdio";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			switch@1d {
				compatible = "motorcomm,yt9215";
				reg = <0x1d>;
				dsa,member = <0x00 0x00>;
				motorcomm,bdy-g98-led-profile;

				ethernet-ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					ethernet-port@1 {
						reg = <0x01>;
						label = "lan1";
						phy-handle = <0x95>;
						phy-mode = "internal";
						local-mac-address = [2e 1c f9 a9 5b 01]; 
					};

					ethernet-port@2 {
						reg = <0x02>;
						label = "lan2";
						phy-handle = <0x96>;
						phy-mode = "internal";
						local-mac-address = [2e 1c f9 a9 5b 02]; 
					};

					ethernet-port@3 {
						reg = <0x03>;
						label = "lan3";
						phy-handle = <0x97>;
						phy-mode = "internal";
						local-mac-address = [2e 1c f9 a9 5b 03]; 
					};

					ethernet-port@4 {
						reg = <0x04>;
						label = "lan4";
						phy-handle = <0x98>;
						phy-mode = "internal";
						local-mac-address = [2e 1c f9 a9 5b 04]; 
					};

					ethernet-port@9 {
						reg = <0x09>;
						ethernet = <0x99>;
						phy-mode = "rgmii-txid";

						fixed-link {
							speed = <0x3e8>;
							full-duplex;
							pause;
						};
					};
				};

				mdio {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					ethernet-phy@1 {
						reg = <0x01>;
						phandle = <0x95>;
					};

					ethernet-phy@2 {
						reg = <0x02>;
						phandle = <0x96>;
					};

					ethernet-phy@3 {
						reg = <0x03>;
						phandle = <0x97>;
					};

					ethernet-phy@4 {
						reg = <0x04>;
						phandle = <0x98>;
					};
				};
			};
		};

		stmmac-axi-config {
			snps,blen = <0x00 0x00 0x00 0x00 0x10 0x08 0x04>;
			snps,wr_osr_lmt = <0x04>;
