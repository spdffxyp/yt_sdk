#
#
# common dependent
#
SDK_INCLUDES += -I$(COMMON_PATH_INC) -I$(INCLUDE_PATH) -I$(OSAL_PATH) \
                -I$(CORE_HAL_PATH) -I$(CORE_SW_CTRL_PATH) \
                -I$(CORE_FAL_PATH) -I$(CORE_CAL_PATH) -I$(CORE_FAL_PROJECT_PATH) \
                -I$(BOARDPROFILE_PATH) -I$(SDK_BASE_PATH) -I$(CORE_CHIP_DEF_PATH) \
				-I$(CORE_MAC_DRV_PATH) -I$(CORE_PHY_DRV_PATH) -I$(CORE_DRV_ETH_PATH)

SDK_SOURCE_DIRS += $(CORE_CAL_PATH) $(CORE_HAL_PATH) \
                   $(CORE_SW_CTRL_PATH) \
				   $(CORE_CHIP_DEF_PATH) $(CORE_MAC_DRV_PATH)

SDK_SOURCE_FILES += $(foreach dir,$(SDK_SOURCE_DIRS),$(wildcard $(dir)/*.c))
SDK_SOURCE_FILES += $(wildcard $(COMMON_PATH_SRC)/*.c)
SHARED_SRC_FILES += $(wildcard $(COMMON_PATH_SRC)/*.c)

#
# compilation switch according to build config
#

ifeq ($(OS_Cyg), YES)
COMMON_COMPILE_FLAG += -DOS_CYGWIN
endif

ifeq ($(OS_FreeRTOS), YES)
COMMON_COMPILE_FLAG += -DOS_FREERTOS
endif

ifeq ($(User_Mode), YES)
COMMON_COMPILE_FLAG += -DOS_LINUX_USR
endif

ifeq ($(OS_Linux), YES)
ifeq ($(Kernel_Mode), YES)
ifeq ($(CPU_ARCH), x86)
COMMON_COMPILE_FLAG += -msoft-float -msse -msse2 -msse3 -msse4
endif
endif
endif

ifeq ($(Tiger), YES)
SWITCH_SERIES := tiger
endif

ifeq ($(Board_AUTO_Detect), YES)
COMMON_COMPILE_FLAG += -DBOARD_AUTO_DETECT
endif

ifeq ($(Board_YT9215_Default_Demo), YES)
COMMON_COMPILE_FLAG += -DBOARD_YT9215_DEFAULT_DEMO
endif

ifeq ($(Board_YT9218MB_Default_Demo), YES)
COMMON_COMPILE_FLAG += -DBOARD_YT9218MB_DEFAULT_DEMO
endif

ifeq ($(Board_YT9214NB_Default_Demo), YES)
COMMON_COMPILE_FLAG += -DBOARD_YT9214NB_DEFAULT_DEMO
endif

ifeq ($(Board_YT9213NB_Default_Demo), YES)
COMMON_COMPILE_FLAG += -DBOARD_YT9213NB_DEFAULT_DEMO
endif

ifeq ($(Board_YT9215RB_Default_Demo), YES)
COMMON_COMPILE_FLAG += -DBOARD_YT9215RB_DEFAULT_DEMO
endif

ifeq ($(Board_YT9215RB_YT8531_Demo), YES)
COMMON_COMPILE_FLAG += -DBOARD_YT9215RB_YT8531_DEMO
endif

ifeq ($(Board_YT9215S_YT8531_Fib_Demo), YES)
COMMON_COMPILE_FLAG += -DBOARD_YT9215S_YT8531_FIB_DEMO
endif

ifeq ($(Board_YT9215S_Fib_Demo), YES)
COMMON_COMPILE_FLAG += -DBOARD_YT9215S_FIB_DEMO
endif

ifeq ($(Board_YT9215SC_Default_Demo), YES)
COMMON_COMPILE_FLAG += -DBOARD_YT9215SC_DEFAULT_DEMO
endif

ifeq ($(Board_YT9218MB_YT8531_Demo), YES)
COMMON_COMPILE_FLAG += -DBOARD_YT9218MB_YT8531_DEMO
endif

ifeq ($(Board_YT9218N_Default_Demo), YES)
COMMON_COMPILE_FLAG += -DBOARD_YT9218N_DEFAULT_DEMO
endif

ifeq ($(Board_YT921X_MULTI_SW_Demo), YES)
COMMON_COMPILE_FLAG += -DBOARD_YT921X_MULTI_SW_DEFAULT_DEMO
endif

ifeq (${SWITCH_SERIES}, tiger)
COMMON_COMPILE_FLAG += -DSWITCH_SERIES_TIGER -DSDK_DATABASE_HW_EN
endif

ifeq (${INTER_MCU}, YES)
SDK_COMPILATION_SWITCHES += -DINTER_MCU
endif

ifdef SWITCH_ACL_NUM
SDK_COMPILATION_SWITCHES += -DSWITCH_MAX_ACL_NUM=${SWITCH_ACL_NUM}
endif
#
# supported phy list
#
SDK_SOURCE_FILES         += $(CORE_PHY_DRV_PATH)/phy_drv.c \
                            $(CORE_PHY_DRV_PATH)/phy_int_yt861x.c

ifeq (${PHY_YT8531}, YES)
SDK_COMPILATION_SWITCHES += -DPHY_YT8531_INCLUDED
SDK_SOURCE_FILES         += $(CORE_PHY_DRV_PATH)/phy_yt8531.c
endif

SDK_SOURCE_FILES         += $(CORE_PHY_DRV_PATH)/phy_int_serdes.c

#
# function modules
#
SDK_SOURCE_FILES         += $(CORE_API_PATH)/yt_init.c \
                            $(CORE_API_PATH)/yt_exit.c


ifneq ($(INTERNAL_MSG_DEBUG), YES)
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_tiger_struct.c \
							$(CORE_FAL_PROJECT_PATH)/fal_tiger_index.c
endif

SDK_SOURCE_FILES         += $(CORE_FAL_PATH)/fal_init.c \
                            $(CORE_FAL_PATH)/fal_dispatch.c

ifeq (${MODULE_MONITOR}, YES)
SDK_COMPILATION_SWITCHES += -DMONITOR_INCLUDED
SDK_SOURCE_FILES         += $(OSAL_PATH)/osal_thread.c
SDK_SOURCE_FILES         += $(CORE_FAL_PATH)/fal_monitor.c
endif

SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_dispatch.c
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_init.c

ifeq (${MODULE_SYS}, YES)
COMMON_COMPILE_FLAG += -DSYS_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_sys.c \
                            $(CORE_API_PATH)/yt_sys.c
endif

ifeq (${MODULE_ACL}, YES)
COMMON_COMPILE_FLAG += -DACL_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_acl.c \
                            $(CORE_API_PATH)/yt_acl.c
endif

ifeq (${MODULE_CTRLPKT}, YES)
COMMON_COMPILE_FLAG += -DCTRLPKT_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_ctrlpkt.c \
                            $(CORE_API_PATH)/yt_ctrlpkt.c
endif

ifeq (${MODULE_DOS}, YES)
COMMON_COMPILE_FLAG += -DDOS_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_dos.c \
                            $(CORE_API_PATH)/yt_dos.c
endif

ifeq (${MODULE_DOT1X}, YES)
COMMON_COMPILE_FLAG += -DDOT1X_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_dot1x.c \
                            $(CORE_API_PATH)/yt_dot1x.c
endif

ifeq (${MODULE_INTERRUPT}, YES)
SDK_COMPILATION_SWITCHES += -DINTERRUPT_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_interrupt.c \
                            $(CORE_API_PATH)/yt_interrupt.c
endif

ifeq (${MODULE_L2}, YES)
COMMON_COMPILE_FLAG += -DL2_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_l2.c \
                            $(CORE_API_PATH)/yt_l2.c
endif

ifeq (${MODULE_LAG}, YES)
COMMON_COMPILE_FLAG += -DLAG_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_lag.c \
                            $(CORE_API_PATH)/yt_lag.c
endif

ifeq (${MODULE_HW_LOOPDETECT}, YES)
SDK_COMPILATION_SWITCHES += -DHW_LOOPDETECT_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_loopdetect.c \
                            $(CORE_API_PATH)/yt_loopdetect.c
endif

ifeq (${MODULE_PORT_MIRROR}, YES)
COMMON_COMPILE_FLAG += -DPORT_MIRROR_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_mirror.c \
                            $(CORE_API_PATH)/yt_mirror.c
endif

ifeq (${MODULE_HW_MULTICAST}, YES)
COMMON_COMPILE_FLAG += -DHW_MULTICAST_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_multicast.c \
                            $(CORE_API_PATH)/yt_multicast.c
endif

ifeq (${MODULE_NIC}, YES)
COMMON_COMPILE_FLAG += -DNIC_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_nic.c \
                            $(CORE_API_PATH)/yt_nic.c
endif

ifeq (${MODULE_OAM}, YES)
COMMON_COMPILE_FLAG += -DOAM_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_oam.c \
                            $(CORE_API_PATH)/yt_oam.c
endif

ifeq (${MODULE_PORT}, YES)
COMMON_COMPILE_FLAG += -DPORT_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_port.c \
                            $(CORE_API_PATH)/yt_port.c
endif

ifeq (${MODULE_PORT_ISO}, YES)
COMMON_COMPILE_FLAG += -DPORT_ISO_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_port_isolation.c \
                            $(CORE_API_PATH)/yt_port_isolation.c
endif

ifeq (${MODULE_QOS}, YES)
COMMON_COMPILE_FLAG += -DQOS_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_qos.c \
                            $(CORE_API_PATH)/yt_qos.c
endif

ifeq (${MODULE_RATE}, YES)
COMMON_COMPILE_FLAG += -DRATE_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_rate.c \
                            $(CORE_API_PATH)/yt_rate.c
endif

ifeq (${MODULE_RMA}, YES)
COMMON_COMPILE_FLAG += -DRMA_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_rma.c \
                            $(CORE_API_PATH)/yt_rma.c
endif

ifeq (${MODULE_STAT}, YES)
COMMON_COMPILE_FLAG += -DSTAT_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_stat.c \
                            $(CORE_API_PATH)/yt_stat.c
endif

ifeq (${MODULE_STORM_CTRL}, YES)
COMMON_COMPILE_FLAG += -DSTORM_CTRL_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_storm_ctrl.c \
                            $(CORE_API_PATH)/yt_storm_ctrl.c
endif

ifeq (${MODULE_HW_STP}, YES)
SDK_COMPILATION_SWITCHES += -DHW_STP_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_stp.c \
                            $(CORE_API_PATH)/yt_stp.c
endif

ifeq (${MODULE_VLAN}, YES)
COMMON_COMPILE_FLAG += -DVLAN_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_vlan.c \
                            $(CORE_API_PATH)/yt_vlan.c
endif

ifeq (${MODULE_VLAN_TRANS}, YES)
COMMON_COMPILE_FLAG += -DVLAN_TRANS_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_vlan_translate.c \
                            $(CORE_API_PATH)/yt_vlan_translate.c
endif

ifeq (${MODULE_WOL}, YES)
COMMON_COMPILE_FLAG += -DWOL_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_wol.c \
                            $(CORE_API_PATH)/yt_wol.c
endif

ifeq (${MODULE_LED}, YES)
COMMON_COMPILE_FLAG += -DLED_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_led.c \
                            $(CORE_API_PATH)/yt_led.c
endif

ifeq (${MODULE_SENSOR}, YES)
COMMON_COMPILE_FLAG += -DSENSOR_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_sensor.c \
                            $(CORE_API_PATH)/yt_sensor.c
endif

ifeq (${MODULE_DEBUG}, YES)
COMMON_COMPILE_FLAG += -DDEBUG_INCLUDED
SDK_SOURCE_FILES         += $(CORE_FAL_PROJECT_PATH)/fal_$(SWITCH_SERIES)_debug.c \
                            $(CORE_API_PATH)/yt_debug.c
endif

#
# add app
#
ifeq ($(UART), YES)
SDK_COMPILATION_SWITCHES += -DACC_UART
SDK_INCLUDES += -I$(CORE_SW_CTRL_PATH)/uart
SDK_SOURCE_FILES += $(CORE_SW_CTRL_PATH)/uart/uart.c
endif

ifeq ($(CTRLIF), YES)
SDK_COMPILATION_SWITCHES += -DACC_CTRLIF
SDK_INCLUDES += -I$(CORE_SW_CTRL_PATH)/ctrlif
SDK_SOURCE_FILES += $(wildcard $(CORE_SW_CTRL_PATH)/ctrlif/*.c)
endif

ifeq ($(MEM), YES)
SDK_COMPILATION_SWITCHES += -DACC_MEM
SDK_INCLUDES += -I$(CORE_SW_CTRL_PATH)/mem
SDK_SOURCE_FILES += $(wildcard $(CORE_SW_CTRL_PATH)/mem/*.c)
endif

ifeq ($(SW_CTRL_IOCTL), YES)
SDK_COMPILATION_SWITCHES += -DSW_CTRL_IOCTL
SDK_INCLUDES += -I$(CORE_SW_CTRL_PATH)/ioctl
SDK_INCLUDES += -I$(SW_CTRL_COMM_INC_SHARE_PATH)
SDK_SOURCE_FILES += $(wildcard $(CORE_SW_CTRL_PATH)/ioctl/*.c)
endif

#sdk lib files
SDK_INCLUDES += -I$(LIB_BOUNDCHK_INC)
TMP_LIB_FILES := $(LIB_BOUNDCHK_SRC)/sprintf_s.c $(LIB_BOUNDCHK_SRC)/vsprintf_s.c
TMP_LIB_FILES += $(LIB_BOUNDCHK_SRC)/strncpy_s.c $(LIB_BOUNDCHK_SRC)/strcpy_s.c
TMP_LIB_FILES +=  $(LIB_BOUNDCHK_SRC)/strcat_s.c $(LIB_BOUNDCHK_SRC)/strtok_s.c
TMP_LIB_FILES += $(LIB_BOUNDCHK_SRC)/memset_s.c $(LIB_BOUNDCHK_SRC)/memcpy_s.c
TMP_LIB_FILES += $(LIB_BOUNDCHK_SRC)/secureprintoutput_a.c
SDK_LIB_SRC_FILES = $(filter $(TMP_LIB_FILES), $(wildcard $(LIB_BOUNDCHK_SRC)/*.c))
SDK_SOURCE_FILES += $(SDK_LIB_SRC_FILES)
SHARED_SRC_FILES += $(SDK_LIB_SRC_FILES)

#simple command line
ifeq ($(CMD_SIMPLE), YES)
CLI_COMPILATION_SWITCHES += -DCMD_SIMPLE
ifeq ($(OS_Linux), YES)
CLI_COMPILATION_SWITCHES += -DOS_LINUX_USR
endif
CLI_INCLUDES += -I$(CMD_CLI_SIMPLE_INCLUDE_PATH)
CLI_INCLUDES += -L$(SDK_ROOT_PATH)/make

CLI_SOURCE_DIRS += $(CMD_CLI_SIMPLE_SRC_PATH)
CLI_SOURCE_DIRS += $(COMMON_PATH_SRC)

ifeq ($(CMD_SMPL_ACCESS_SDK_DIRECT), YES)
CLI_COMPILATION_SWITCHES += -DCMD_SMPL_ACCESS_SDK_DIRECT
TMP_CLI_SOURCE_FILES = $(foreach dir,$(CLI_SOURCE_DIRS),$(wildcard $(dir)/*.c))
CLI_SOURCE_FILES += $(filter-out $(CMD_CLI_SIMPLE_SRC_PATH)/cli_ioctl.c, $(TMP_CLI_SOURCE_FILES))
endif
ifeq ($(CMD_SMPL_ACCESS_SDK_IOCTL), YES)
CLI_COMPILATION_SWITCHES += -DCMD_SMPL_ACCESS_SDK_IOCTL
CLI_INCLUDES += -I$(CMD_SMPL_IOCTL_SHARED)
CLI_INCLUDES += -I$(CMD_CLI_SIMPLE_INCLUDE_IOCTL_PATH)
CLI_INCLUDES += -I$(OSAL_PATH)

CLI_SOURCE_DIRS += $(CMD_CLI_SIMPLE_SRC_IOCTL_PATH)

TMP_CLI_SOURCE_FILES = $(foreach dir,$(CLI_SOURCE_DIRS),$(wildcard $(dir)/*.c))
CLI_SOURCE_FILES += $(filter-out $(CMD_CLI_SIMPLE_SRC_PATH)/cli_smpl.c, $(TMP_CLI_SOURCE_FILES))

#add related kernel files
SDK_SOURCE_FILES += $(foreach dir,$(CMD_SMPL_COMM_SRC),$(wildcard $(dir)/*.c))
SDK_INCLUDES += -I$(CMD_SMPL_COMM_INC)
SDK_INCLUDES += -I$(CMD_SMPL_IOCTL_SHARED)
SDK_INCLUDES += -I$(CMD_CLI_SIMPLE_INCLUDE_PATH)
SDK_COMPILATION_SWITCHES += -DCMD_SMPL_ACCESS_SDK_IOCTL
endif

#cli lib files
CLI_INCLUDES += -I$(LIB_BOUNDCHK_INC)
CLI_LIB_SRC_DIRS += $(LIB_BOUNDCHK_SRC)
CLI_LIB_SRC_FILES += $(foreach dir,$(CLI_LIB_SRC_DIRS),$(wildcard $(dir)/*.c))

CLI_SOURCE_FILES += $(CLI_LIB_SRC_FILES)
endif

#
# all objects
#
ifeq ($(findstring YES, $(SDK_CYG_EXE_WITH_CLI)$(SDK_USER_MODE_EXE_WITH_CLI)), YES)
SDK_SOURCE_FILES := $(filter-out $(SHARED_SRC_FILES), $(SDK_SOURCE_FILES))
endif
SDK_SOURCE_FILES := $(sort $(SDK_SOURCE_FILES))
CLI_SOURCE_FILES := $(sort $(CLI_SOURCE_FILES))

SDK_SOURCE_OBJECTS += $(patsubst %.c,%.o,$(SDK_SOURCE_FILES))
CLI_SOURCE_OBJECTS += $(patsubst %.c,%.d.o,$(CLI_SOURCE_FILES))

SHARED_SRC_OBJECTS += $(patsubst %.c,%.o,$(SHARED_SRC_FILES))

#
# Path conversion(Relative path/Absolute path)
#

TMP_OBJECTS = $(subst $(SDK_BASE_PATH), .., $(SDK_SOURCE_OBJECTS))
SDK_SOURCE_OBJECTS := $(TMP_OBJECTS)

TMP_OBJECTS = $(subst $(SDK_BASE_PATH), .., $(CLI_SOURCE_OBJECTS))
CLI_SOURCE_OBJECTS := $(TMP_OBJECTS)

TMP_OBJECTS = $(subst $(SDK_BASE_PATH), .., $(SHARED_SRC_OBJECTS))
SHARED_SRC_OBJECTS := $(TMP_OBJECTS)


#clean exclude files
CLEAN_EXCLUDE_FILES := $(CORE_DRV_ETH_PATH)/eth.c.o

TMP_EXCLUDE_FILES = $(subst $(SDK_BASE_PATH), .., $(CLEAN_EXCLUDE_FILES))
CLEAN_EXCLUDE_FILES := $(TMP_EXCLUDE_FILES)
